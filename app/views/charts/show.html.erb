<% content_for :title, @chart.title %>

<div class="chart-show-header">
  <%= link_to "← My Mandalas", charts_path %>
  <h1><%= @chart.title %></h1>
  <span class="chart-mode-badge"><%= @chart.mode %></span>
</div>

<div class="mandala-grid">
  <% @tiles.each do |tile| %>
    <turbo-frame id="tile_<%= tile.id %>">
      <div class="mandala-tile <%= 'tile-center' if tile.position == 4 %> <%= 'tile-has-children' if tile.has_children? %>">
        <%= link_to tile.content.presence || "+", edit_chart_tile_path(@chart, tile), class: "tile-content" %>
        <%= link_to "▶", drill_chart_tile_path(@chart, tile), class: "tile-drill", data: { turbo_frame: "_top" } %>
      </div>
    </turbo-frame>
  <% end %>
</div>
