<% content_for :title, "My Mandalas" %>

<div class="charts-header">
  <h1>My Mandalas</h1>
  <%= link_to "New Mandala", new_chart_path, class: "button" %>
</div>

<% if @charts.empty? %>
  <p class="empty-state">No mandalas yet. Create your first one.</p>
<% else %>
  <div class="charts-list">
    <% @charts.each do |chart| %>
      <div class="chart-card">
        <div class="chart-card-info">
          <span class="chart-title"><%= chart.title %></span>
          <span class="chart-mode"><%= chart.mode %></span>
        </div>
        <div class="chart-card-actions">
          <%= link_to "Open", chart_path(chart), class: "button" %>
          <%= button_to "Delete", chart_path(chart), method: :delete,
                data: { confirm: "Delete #{chart.title}?" },
                class: "button button-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
