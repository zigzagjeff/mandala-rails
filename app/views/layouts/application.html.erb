<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mandala Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mandala Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <script type="module" src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.12/dist/turbo.es2017-esm.js"></script>
  </head>

  <body>
    <nav class="app-nav">
      <span class="app-nav-brand">Mandala</span>
      <% if authenticated? %>
        <span class="app-nav-user"><%= Current.user.email_address %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "button button-small" %>
      <% end %>
    </nav>

    <main class="app-main">
      <%= yield %>
    </main>
  </body>
</html>
