<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mandala Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mandala Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= stylesheet_link_tag "lexxy" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="app-nav">
      <span class="app-nav-brand">Mandala</span>
      <% if authenticated? %>
        <span class="app-nav-user"><%= Current.user.email_address %></span>
        <%= button_to "Sign out", session_path, method: :delete, class: "button button-small" %>
      <% end %>
    </nav>

    <% flash.each do |type, message| %>
      <%= tag.div message, class: "flash flash-#{type}" %>
    <% end %>

    <% if authenticated? && Current.user.unverified? %>
      <div class="app-banner">
        Please verify your email address.
        <%= button_to "Resend verification", email_verifications_path, class: "button button-small" %>
      </div>
    <% end %>

    <% if authenticated? && Current.user.closed? %>
      <div class="app-banner">
        Your account is scheduled for deletion on <%= Current.user.deletes_on.to_date.to_fs(:long) %>.
        <%= button_to "Cancel deletion", account_closure_path, method: :delete, class: "button button-small" %>
      </div>
    <% end %>

    <main class="app-main">
      <%= yield %>
    </main>

    <footer class="app-footer">
      <%= link_to "Privacy Policy", privacy_path %>
      <%= link_to "Terms of Service", terms_path %>
      <%= link_to "Legal Notice", legal_path %>
    </footer>
  </body>
</html>
