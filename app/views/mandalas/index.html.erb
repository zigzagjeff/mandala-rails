<% content_for :title, "My Mandalas" %>

<div class="mandalas-header">
  <h1>My Mandalas</h1>
  <%= link_to "New Mandala", new_mandala_path, class: "button" %>
</div>

<% if @mandalas.empty? %>
  <p class="empty-state">No mandalas. Create one when you're ready.</p>
<% else %>
  <div class="mandalas-list">
    <% @mandalas.each do |mandala| %>
      <div class="mandala-card">
        <div class="mandala-card-info">
          <span class="mandala-title"><%= mandala.title %></span>
          <% if (center = mandala.center_tile) && center.title.present? %>
            <span class="mandala-center-preview"><%= center.title %></span>
          <% end %>
        </div>
        <div class="mandala-card-actions">
          <%= link_to "Open", mandala_path(mandala), class: "button" %>
          <%= button_to "Delete", mandala_path(mandala), method: :delete,
                data: { confirm: "Delete #{mandala.title}?" },
                class: "button button-danger" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
