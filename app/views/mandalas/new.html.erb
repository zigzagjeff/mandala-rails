<% content_for :title, "New Mandala" %>

<div class="form-wrapper">
  <h1>New Mandala</h1>

  <%= form_with model: @mandala do |f| %>
    <% if @mandala.errors.any? %>
      <div class="form-errors">
        <% @mandala.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :title, "Title" %>
      <%= f.text_field :title, placeholder: "What are you working on?" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Create Mandala", class: "button" %>
      <%= link_to "Cancel", mandalas_path %>
    </div>
  <% end %>
</div>
