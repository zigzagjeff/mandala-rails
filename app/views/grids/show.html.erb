<% content_for :title, @chart.title %>

<%= turbo_stream_from @chart %>

<div class="chart-show-header">
  <div class="breadcrumb">
    <%= link_to "← My Mandalas", charts_path %>
    <span class="breadcrumb-sep">›</span>
    <%= link_to @chart.title, chart_path(@chart) %>
    <% @breadcrumb.each do |crumb| %>
      <span class="breadcrumb-sep">›</span>
      <%= link_to crumb[:label], chart_grid_path(@chart, crumb[:grid]) %>
    <% end %>
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current"><%= @parent_tile&.title %></span>
  </div>
  <span class="chart-mode-badge"><%= @chart.mode %></span>
</div>

<div class="mandala-grid">
  <% @tiles.each do |tile| %>
    <turbo-frame id="tile_<%= tile.id %>">
      <%= render "tiles/tile", tile: tile, chart: @chart %>
    </turbo-frame>
  <% end %>
</div>
