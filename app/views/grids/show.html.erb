<% content_for :title, @mandala.title %>

<%= turbo_stream_from @mandala %>

<div class="mandala-show-header">
  <div class="breadcrumb">
    <%= link_to "← My Mandalas", mandalas_path %>
    <span class="breadcrumb-sep">›</span>
    <%= link_to @mandala.title, mandala_path(@mandala) %>
    <% @breadcrumb.each do |crumb| %>
      <span class="breadcrumb-sep">›</span>
      <%= link_to crumb[:label], mandala_grid_path(@mandala, crumb[:grid]) %>
    <% end %>
    <span class="breadcrumb-sep">›</span>
    <span class="breadcrumb-current"><%= @parent_tile&.title %></span>
  </div>
</div>

<div class="mandala-grid">
  <% @tiles.each do |tile| %>
    <turbo-frame id="tile_<%= tile.id %>">
      <%= render "tiles/tile", tile: tile, mandala: @mandala %>
    </turbo-frame>
  <% end %>
</div>
