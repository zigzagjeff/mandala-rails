<% content_for :title, "Edit: #{@tile.display_title}" %>

<div class="tile-document-header">
  <%= link_to "← Back", surface_path, class: "tile-document-back" %>
  <div class="tile-document-context">
    <span class="tile-document-chart-title"><%= @chart.title %></span>
    <% unless @tile.grid.root? %>
      <span class="tile-document-sep">›</span>
      <span class="tile-document-grid-label"><%= @tile.grid.parent_tile&.display_title %></span>
    <% end %>
  </div>
</div>

<div class="tile-document-page">
  <%= form_with model: [@chart, @tile], class: "tile-document-form" do |f| %>
    <div class="tile-document-title-wrap" data-controller="character-counter" data-character-counter-max-value="<%= Tile::TITLE_MAX_LENGTH %>">
      <%= f.text_field :title,
            placeholder: "Title",
            autofocus: true,
            maxlength: Tile::TITLE_MAX_LENGTH,
            class: "tile-document-title",
            data: { character_counter_target: "field", action: "input->character-counter#update" } %>
      <span class="char-counter">
        <span data-character-counter-target="count"><%= @tile.title&.length || 0 %></span>/<%= Tile::TITLE_MAX_LENGTH %>
      </span>
    </div>
    <div class="tile-document-subtitle-wrap" data-controller="character-counter" data-character-counter-max-value="<%= Tile::SUBTITLE_MAX_LENGTH %>">
      <%= f.text_field :subtitle,
            placeholder: "Subtitle",
            maxlength: Tile::SUBTITLE_MAX_LENGTH,
            class: "tile-document-subtitle",
            data: { character_counter_target: "field", action: "input->character-counter#update" } %>
      <span class="char-counter">
        <span data-character-counter-target="count"><%= @tile.subtitle&.length || 0 %></span>/<%= Tile::SUBTITLE_MAX_LENGTH %>
      </span>
    </div>
    <div class="tile-document-body">
      <%= f.lexxy_rich_text_area :body, placeholder: "Body" %>
    </div>
    <div class="tile-document-actions">
      <%= f.submit "Save", class: "button" %>
      <%= link_to "Cancel", surface_path, class: "tile-edit-cancel" %>
    </div>
  <% end %>
</div>
