<div class="mandala-tile <%= "tile-center" if tile.center? %> <%= "tile-has-children" if tile.has_children? %>">
  <%= link_to tile.title.presence || tile.title_placeholder, rename_chart_tile_path(chart, tile),
        class: [ "tile-title", "tile-title-zone", "tile-title--placeholder": tile.title.blank? ], title: "Rename" %>
  <%= link_to edit_chart_tile_path(chart, tile),
        class: "tile-body-zone", data: { turbo_frame: "_top" }, title: "Write" do %>
    <% if tile.subtitle.present? %>
      <span class="tile-subtitle"><%= tile.subtitle %></span>
    <% end %>
    <% if tile.body.present? %>
      <span class="tile-body-preview"><%= tile.body_preview %></span>
    <% end %>
  <% end %>
  <% if tile.drillable? %>
    <%= link_to "▶", drill_chart_tile_path(chart, tile),
          class: "tile-drill", data: { turbo_frame: "_top" }, title: "Open sub-grid" %>
  <% end %>
</div>
