# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files...
/.env*
# ...but track the template that documents them.
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Kamal registry token (ghcr.io PAT) — pulled into .kamal/secrets at deploy time.
/.kamal/.registry_password

# Scaleway credentials for Litestream — pulled into .kamal/secrets at deploy time.
/.kamal/.s3_access_key_id
/.kamal/.s3_secret_access_key

# Private planner (DHH pipeline) — loads globally from ~/.claude/CLAUDE.md,
# never travels with the public repo. A project-only CLAUDE.local.md, if
# ever needed, stays local too.
/CLAUDE.md
/CLAUDE.local.md

# Local working notes, not for publication.
/resources/

# Ignore personal, machine-specific Claude Code config...
.claude/*
# ...but share the team tooling that should travel with the repo.
!.claude/settings.json
!.claude/hooks/
# Project-owned skills travel too; environment-provided skills
# (dhh-coder and friends, symlinked from outside the repo) stay local.
!.claude/skills/
.claude/skills/*
!.claude/skills/mandala/
!.claude/skills/bugs-reproducer/

# macOS Finder droppings
.DS_Store

# opencode CLI config (not part of this project's toolchain)
/.opencode/
/opencode.json
