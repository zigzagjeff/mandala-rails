# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit real values.
#
# Rails reads config/master.key automatically, so a typical local setup needs
# nothing here. Set a variable only to override a default or to run the agent
# tooling. Every line below is optional and commented out.

# --- Credentials -----------------------------------------------------------
# Decrypts config/credentials.yml.enc. Only needed when config/master.key is
# absent (e.g. a fresh public clone, which does not include the key). A clone
# without the original key should regenerate its own credentials:
#   rm config/credentials.yml.enc && bin/rails credentials:edit
# RAILS_MASTER_KEY=

# --- Web / runtime (defaults shown) ----------------------------------------
# PORT=3000
# RAILS_MAX_THREADS=5
# JOB_CONCURRENCY=1
# RAILS_LOG_LEVEL=info

# --- Agent tooling (bin/mandala, bin/mcp, lib/mandala API client) -----------
# Only needed to drive the app over API v1 from the CLI or MCP sidecar; see
# AGENTS.md. Mint a token with:
#   bin/rails runner 'print User.first.api_token'
# MANDALA_URL=http://localhost:3000
# MANDALA_API_TOKEN=

# --- Production mail (Track B / Track C) -----------------------------------
# SMTP credentials and the mailer host are not wired yet. This section will be
# filled in when issues #73 (SMTP), #76, and #77 land.
